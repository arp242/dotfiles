var qf_closed = false
def OpenQF()
    cclose
    if qf_closed
        return
    endif
    var l = getqflist()->len()
    if l > 0
        exe 'copen ' .. min([10, l])
        wincmd p
    endif
enddef
def ToggleQF()
    for n in range(1, winnr('$'))
        if getwinvar(n, '&filetype') == 'qf'
            qf_closed = true
            cclose
            return
        endif
    endfor
    qf_closed = false
    s:OpenQF()
enddef

augroup qf
    au!
    # Open quickfix after :make if there are any errors.
    au QuickFixCmdPost make :call s:OpenQF()
    # List is "sticky" between tabs.
    au TabEnter * :call s:OpenQF()
    # Close when closing main window.
    autocmd QuitPre * silent! cclose
augroup end

