    import autoload 'lsp/lsp.vim'
    augroup my-lsp
        def g:Sig()
            var s = lsp.Server()
            if s->empty()
                return
            endif

            var save = winsaveview()
            var sig = s.rpc('textDocument/signatureHelp', s.getTextDocPosition(false))
            if sig.result->empty()
                # TODO: don't go to next line with w
                # actually, would be better if we just leave the cursor alone altogether.
                normal! w
                if getline('.')[charcol('.') - 1] == '.'
                    normal! l
                    sig = s.rpc('textDocument/signatureHelp', s.getTextDocPosition(false))
                endif
            endif
            if sig.result->empty()
                normal! F(
                if getline('.')[charcol('.') - 1] == '('
                    sig = s.rpc('textDocument/signatureHelp', s.getTextDocPosition(false))
                endif
            endif
            winrestview(save)

            echon "\r\r"
            if sig.result->empty()
                echon 'No signature found'
            else
                echon sig.result.signatures[0].label
            endif
        enddef

